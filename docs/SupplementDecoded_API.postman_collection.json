            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ashwagandha (Withania somnifera): Updated 2026 Dossier\",\n  \"content\": \"<p>Updated monograph text with latest randomized controlled trials.</p>\"\n}"
