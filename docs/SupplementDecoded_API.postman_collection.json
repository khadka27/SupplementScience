              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"phosphatidylserine-monograph\",\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blog/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blog",
                "posts"
              ]
