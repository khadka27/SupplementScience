            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Phosphatidylserine: Clinical Monograph & Cognitive Trials\",\n  \"slug\": \"phosphatidylserine-monograph\",\n  \"excerpt\": \"Evidence-based clinical review of Phosphatidylserine evaluating human RCTs on cognitive decline, working memory, and cortisol regulation.\",\n  \"content\": \"<h2>Executive Summary</h2><p>Phosphatidylserine (PS) is a phospholipid component of human cellular membranes, highly enriched in neural tissue.</p><h3>Key Clinical Outcomes</h3><p>Human randomized controlled trials demonstrate 300 mg/day supports working memory kinetics and blunts acute ACTH/cortisol response to mental stress.</p>\",\n  \"status\": \"PUBLISHED\",\n  \"postType\": \"ingredient\",\n  \"metaTitle\": \"Phosphatidylserine: Clinical Evidence & Dosage Guide\",\n  \"metaDescription\": \"Double-blind clinical monographs analyzing Phosphatidylserine bioactives and human trial outcomes.\",\n  \"featuredImageUrl\": \"/images/placeholders/sample.jpg\",\n  \"featuredImageAlt\": \"Phosphatidylserine phospholipid matrix\",\n  \"cardImageUrl\": \"/images/placeholders/sample.jpg\",\n  \"readTimeMinutes\": 6,\n  \"categoryId\": \"{{category_id}}\",\n  \"authorId\": \"{{author_id}}\",\n  \"tagIds\": [],\n  \"factCheckedBy\": \"SupplementDecoded Research Editorial Team\",\n  \"reviewedBy\": \"SupplementDecoded Research Editorial Team\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blog/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blog",
                "posts"
              ]
            },
            "description": "Creates and optionally publishes a new post or monograph."
          }
        },
        {
          "name": "Update Post by Body Identifier (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"phosphatidylserine-monograph\",\n  \"title\": \"Phosphatidylserine: Updated Clinical Monograph & New RCTs\",\n  \"content\": \"<h2>Updated Clinical Review</h2><p>Updated content with 2026 meta-analysis findings.</p>\",\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blog/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blog",
                "posts"
              ]
            },
            "description": "Updates an existing post by identifying it via slug or id in the JSON body."
          }
        },
        {
          "name": "Partial Update Post by Body Identifier (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
